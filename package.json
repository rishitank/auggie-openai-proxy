{
  "name": "auggie-openai-proxy",
  "version": "1.1.0",
  "description": "OpenAI-compatible API proxy for Augment Code using Auggie SDK",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs",
    "test:watch": "node --experimental-vm-modules node_modules/vitest/vitest.mjs --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/vitest/vitest.mjs --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "augment",
    "openai",
    "proxy",
    "ai",
    "chatbot"
  ],
  "author": "Montbot",
  "license": "MIT",
  "dependencies": {
    "@augmentcode/auggie-sdk": "^0.1.0",
    "ai": "^4.0.0",
    "express": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  }
}

