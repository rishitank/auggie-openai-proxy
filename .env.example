# =============================================================================
# Auggie OpenAI Proxy Configuration
# =============================================================================

# Augment API Credentials
# Get your token from ~/.augment/session.json (accessToken field)
# Or leave empty to auto-detect from session file
AUGMENT_API_TOKEN=
AUGMENT_API_URL=https://api.augmentcode.com

# Server Configuration
PORT=3456
HOST=0.0.0.0

# Default model for requests without explicit model
# Available: claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-5, claude-sonnet-4, gpt-5
DEFAULT_MODEL=claude-sonnet-4-5

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# Context Enhancement (Optional)
# =============================================================================
# Enable codebase context enhancement for prompts
# When enabled, user messages are enriched with relevant code snippets

# Enable context enhancement (true/false)
CONTEXT_ENABLED=false

# Directory to index for context (absolute path)
# CONTEXT_WORKSPACE_DIR=/path/to/your/project

# File to persist index state (avoids re-indexing on restart)
# CONTEXT_STATE_FILE=/path/to/context-state.json

# Maximum file size to index in bytes (default: 102400 = 100KB)
# CONTEXT_MAX_FILE_SIZE=102400

