# =============================================================================
# Auggie OpenAI Proxy Configuration
# =============================================================================

# Augment API Credentials
# Get your token from ~/.augment/session.json (accessToken field)
# Or leave empty to auto-detect from session file
AUGMENT_API_TOKEN=
AUGMENT_API_URL=https://api.augmentcode.com

# Server Configuration
PORT=3456
HOST=0.0.0.0

# Default model for requests without explicit model
DEFAULT_MODEL=claude-sonnet-4-5

# Logging level: debug, info, warn, error
LOG_LEVEL=info

