# Auggie SDK Configuration
# Option 1: Direct API credentials
AUGMENT_API_TOKEN=your-augment-api-token-here
AUGMENT_API_URL=https://api.augmentcode.com

# Option 2: Path to session file (will use ~/.augment/session.json by default)
# AUGMENT_SESSION_FILE=~/.augment/session.json

# Server Configuration
PORT=3456
HOST=0.0.0.0

# Clawdbot Integration
CLAWDBOT_GATEWAY_URL=http://localhost:18789
CLAWDBOT_GATEWAY_TOKEN=your-clawdbot-gateway-token

# Optional: Enable debug logging
DEBUG=false

